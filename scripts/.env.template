# Copia questo file in scripts/.env e sostituisci i valori mascherati con ***.
# Vedi scripts/config.py per i default usati quando una variabile è assente.

# --- Roboflow ---
RF_API_KEY=***
DOWNLOAD_FORMAT=yolov8

# --- Percorsi (relativi alla root del progetto / a DATA_ROOT) ---
DATA_ROOT=data
# nome dell indice CSV con i riferimenti ai dataset da scaricare e lo stato di scaricato o meno - per aggiungere un dataset, aggiungere una riga con stato todo
CSV_FILENAME=datasets_to_download.csv
# indice JSON con i metadati dei dataset scaricati - creato e mantenuto da script
INDEX_FILENAME=datasets.json
# base per i dataset allo stato grezzo (raw), così come trovati
RAW_DIRNAME=raw
README_FILENAME=README.md
# lista delle immagini selezionate
CANDIDATES_FILENAME=selected_images.txt
# indice con metadati (percorso completo, dimensioni) e decisione di esclusione per ogni immagine esaminata
IMAGE_INDEX_FILENAME=image_index.json
SELECT_IMAGES_LOG_FILENAME=logs/select_images.log
# lista delle immagini scartate perché rilevate bounding box inclusive di scooter e conducente
FLAGGED_RIDER_FILENAME=flagged_rider_contamination.txt
# lista delle immagini scartate per soglia di area di una bbox escooter (troppo grande o troppo piccola)
FLAGGED_AREA_FILENAME=flagged_area_threshold.txt
# cache delle inferenze YOLO coco, utilizzate per varie analisi qualitative
VARIETY_CACHE_FILENAME=cache/variety_filter_cache.json
# cache dei perceptual hash per immagine, usata dallo stadio dedup
PHASH_CACHE_FILENAME=cache/phash_cache.json
# target per li dataset unione e materiale collegato
UNION_DIRNAME=processed/union
# sample per colpo d'occhio del dataset unione, per revisione visiva
UNION_REVIEW_SAMPLE_DIRNAME=processed/union_review_sample
# target per il dataset unione filtrato secondo le decisioni di review_app.py (solo "select"), prodotto da materialize_union_reviewed.py
UNION_REVIEWED_DIRNAME=processed/union_reviewed
# target per il dataset union_reviewed deduplicato per pHash a posteriori, prodotto da dedupe_phash.py
UNION_REVIEWED_PHASHDEDUP_DIRNAME=processed/union_reviewed_phashdedup
# scarti per bounding box monopattino e conducente (flagged rider contamination)
RIDER_CONTAMINATED_DIRNAME=processed/rider_contaminated
RIDER_CONTAMINATED_REVIEW_SAMPLE_DIRNAME=processed/rider_contaminated_review_sample
# una cartella per dataset con tutte le immagini della selezione finale annotate (solo bbox escooter)
BYDATASET_DIRNAME=processed/bydataset
# dataset finale con anche le classi COCO annotate, prodotto da annotate_coco_classes.py
UNION_REVIEWED_COCO_DIRNAME=processed/union_reviewed_coco
# cache delle inferenze YOLO coco per l'annotazione finale (con confidence, a differenza della cache del filtro varietà)
COCO_ANNOTATION_CACHE_FILENAME=cache/coco_annotation_cache.json

# --- Classi ---
ESCOOTER_CLASS_ID=80
PERSON_CLASS_ID=0

# --- Filtri selezione immagini (select_images.py) ---
# proporzione max tollerata fra bounding box monopattino e area immagine totale
CLOSEUP_AREA_THRESHOLD=0.3
# proporzione min tollerata fra bounding box monopattino e area immagine totale
FARAWAY_AREA_THRESHOLD=0.001
# superfice minima dell'immagine
MIN_PIXELS=250000
# distanza di hamming massima basata su perceptual hash - utilizzata per deduplicare immagini simili
PHASH_DISTANCE_THRESHOLD=10
# frazione dell'area della bbox escooter coperta da una detection persona perché la coppia sia considerata (precondizione spaziale prima del confronto altezze)
RIDER_OVERLAP_THRESHOLD=0.3
# rapporto (altezza escooter / altezza persona) oltre il quale si considera il conducente incluso nell'annotazione
RIDER_HEIGHT_RATIO_THRESHOLD=1.0

# --- Modello varietà COCO (select_images.py) ---
# modello per inferenza classi COCO - per analisi qualitativa
COCO_MODEL=yolo11l.pt
COCO_BATCH_SIZE=16
# frequenza di salvataggio della cache delle inferenze COCO - per evitare di perdere tutto in caso di crash
VARIETY_CACHE_SAVE_EVERY=20
# istanze COCO minime nell'orientazione originale perché un'immagine sia considerata di buona varietà
VARIETY_MIN_INSTANCES=2

# --- Annotazione classi COCO sul dataset finale (annotate_coco_classes.py) ---
# soglia di confidenza in fase di inferenza/cache, bassa apposta per poter ritarare la soglia
# effettiva senza rifare l'inferenza
COCO_ANNOTATION_CAPTURE_CONF=0.1
# soglia di confidenza effettiva applicata in scrittura (le detection diventano etichette permanenti)
COCO_ANNOTATION_CONF_THRESHOLD=0.45
# frazione di area di una detection COCO diversa da persona coperta da una bbox escooter oltre la quale viene scartata (non IoU simmetrico, per catturare anche detection molto più piccole della bbox escooter)
COCO_ESCOOTER_OVERLAP_THRESHOLD=0.6
# classi COCO (id separati da virgola) plausibili come misclassificazione del monopattino (bici, moto, skateboard, snowboard): solo queste sono soggette allo scarto per overlap sopra
COCO_ESCOOTER_LOOKALIKE_CLASSES=1,3,31,36
# classi COCO implausibili in una scena esterna (marciapiede/strada), scartate a prescindere dalla confidenza perché un errore di classificazione ad alta confidenza non è intercettabile con la sola soglia generale; stringa vuota per disattivare il filtro
# 40 wine glass, 42 fork, 44 spoon, 57 couch, 59 bed, 60 dining table, 61 toilet, 62 tv, 64 mouse, 65 remote, 66 keyboard, 68 microwave, 69 oven, 70 toaster, 71 sink, 72 refrigerator, 78 hair drier, 79 toothbrush
COCO_IMPLAUSIBLE_CLASSES=40,42,44,57,59,60,61,62,64,65,66,68,69,70,71,72,77,78,79
# elenco delle detection scartate per overlap con bbox escooter (classi sosia), per revisione manuale
FLAGGED_COCO_OVERLAP_FILENAME=flagged_coco_overlap.txt
# nomi immagine (uno per riga) per cui disattivare lo scarto per overlap sosia dopo revisione manuale
COCO_OVERLAP_RESCUE_FILENAME=coco_overlap_rescue.txt
COCO_ANNOTATION_CACHE_SAVE_EVERY=20

# --- Dedupe augmented (dedupe_augmented.py) ---
# parametri per la rilevazione di angoli neri generati da augmentation per rotazione
BLACK_THRESHOLD=10
EDGE_SAMPLE=30

# --- Controllo visivo campione (build_visual_check_sample.py) ---
BOX_COLOR=255,0,0
# colore della bbox persona, disegnata da build_visual_check_sample.py accanto a quella escooter quando è stato rilevato un conducente incluso
PERSON_BOX_COLOR=0,255,0
# colore delle bbox delle altre classi COCO, disegnata da annotate_coco_classes.py --sample
COCO_BOX_COLOR=0,128,255
# colore delle bbox scartate per overlap sosia, disegnate da --export-flagged-sample
COCO_FLAGGED_BOX_COLOR=255,140,0
BOX_WIDTH=4

# --- App di revisione (review_app.py) ---
REVIEW_APP_PORT=8765
